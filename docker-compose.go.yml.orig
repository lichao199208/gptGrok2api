services:
  redis:
    image: redis:7-alpine
    container_name: gptgrok2api-go-redis
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes"]
    volumes:
      - ./data/redis:/data

  app:
    build:
      context: .
      dockerfile: Dockerfile.golang
    image: ${CHATGPT2API_GO_IMAGE:-gptgrok2api-go:local}
    container_name: gptgrok2api-go
    restart: unless-stopped
    ports:
      - "${CHATGPT2API_GO_PORT:-3000}:80"
    volumes:
      - ./data:/app/data
      - ./logs:/app/logs
    environment:
      CHATGPT2API_AUTH_KEY: ${CHATGPT2API_AUTH_KEY:-}
      CHATGPT2API_ADMIN_KEY: ${CHATGPT2API_ADMIN_KEY:-}
      GO_CONFIG_PATH: ${GO_CONFIG_PATH:-/app/data/config.json}
      GO_UPSTREAM_URL: ${GO_UPSTREAM_URL:-}
      GO_UPSTREAM_API_KEY: ${GO_UPSTREAM_API_KEY:-}
      GO_PUBLIC_BASE_URL: ${GO_PUBLIC_BASE_URL:-}
      GO_TRUST_REQUEST_PUBLIC_BASE: ${GO_TRUST_REQUEST_PUBLIC_BASE:-false}
      GO_GROK_CHAT_URL: ${GO_GROK_CHAT_URL:-https://grok.com/rest/app-chat/conversations/new}
      GO_CONSOLE_RESPONSES_URL: ${GO_CONSOLE_RESPONSES_URL:-https://console.x.ai/v1/responses}
      GO_REQUEST_TIMEOUT_SECONDS: ${GO_REQUEST_TIMEOUT_SECONDS:-600}
      GO_CHAT_MAX_RETRIES: ${GO_CHAT_MAX_RETRIES:-5}
      GO_CHAT_RETRY_CODES: ${GO_CHAT_RETRY_CODES:-401,403,429,500,502,503}
      GO_ACCOUNT_REFRESH_CONCURRENCY: ${GO_ACCOUNT_REFRESH_CONCURRENCY:-3}
      GO_ALLOW_ANONYMOUS: ${GO_ALLOW_ANONYMOUS:-false}
      GO_QUEUE_BACKEND: ${GO_QUEUE_BACKEND:-redis}
      GO_REDIS_ADDR: ${GO_REDIS_ADDR:-redis:6379}
      GO_REDIS_PASSWORD: ${GO_REDIS_PASSWORD:-}
      GO_REDIS_DB: ${GO_REDIS_DB:-0}
      GO_PROXY_URL: ${GO_PROXY_URL:-}
      GO_PROXY_POOL: ${GO_PROXY_POOL:-}
      GO_RESOURCE_PROXY_URL: ${GO_RESOURCE_PROXY_URL:-}
      GO_RESOURCE_PROXY_POOL: ${GO_RESOURCE_PROXY_POOL:-}
      GO_ALLOW_PRIVATE_IMAGE_URLS: ${GO_ALLOW_PRIVATE_IMAGE_URLS:-false}
      GO_FLARESOLVERR_URL: ${GO_FLARESOLVERR_URL:-}
      GO_CLEARANCE_ENABLED: ${GO_CLEARANCE_ENABLED:-false}
      GO_CLEARANCE_TIMEOUT_SECONDS: ${GO_CLEARANCE_TIMEOUT_SECONDS:-60}
      TZ: ${TZ:-Asia/Shanghai}
    networks:
      default:
      upstream:
        aliases:
          - gptgrok2api-go

networks:
  upstream:
    external: true
    name: gptgrok2api_default
